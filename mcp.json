{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "health-timeline": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp-server.mjs"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "HEALTH_TIMELINE_DATA_DIR": "${PLUGIN_DATA}"
      }
    }
  }
}
